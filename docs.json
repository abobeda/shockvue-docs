{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "OpenZero",
  "colors": {
    "primary": "#040405",
    "light": "#07C983",
    "dark": "#ffffff"
  },
  "favicon": "/images/favicon.ico",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Docs",
          "icon": "book-open-cover",
          "href": "https://docs.openzero.com.br/"
        },
        {
          "anchor": "OpenZero",
          "icon": "house",
          "href": "https://www.openzero.com.br/"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Primeiros passos",
            "pages": [
              "index",
              "smart-edit",
              "editing-examples",
              "prompting-guide",
              "remix-images",
              "prompt-best-practices"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/openzero-logo.png",
    "dark": "/images/openzero-logo-white.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Suporte",
        "href": "mailto:suporte@openzero.com.br"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Edit",
      "href": "https://shockvueapp.com/app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "instagram": "https://www.instagram.com/openzero.ai/"
    }
  },
  "thumbnails": {
    "background": "/images/paint-more-day.jpg",
    "appearance": "light"
  }
}